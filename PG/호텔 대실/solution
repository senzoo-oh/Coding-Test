import java.util.*;

class Solution {
    public int solution(String[][] book_time) {
        
        int answer = 0;

        // book_time 문자열을 숫자로 바꾼다.
        int[][] bookTime = new int[book_time.length][2];
        
        for (int i = 0; i < book_time.length; i++) {

            String[] startTime = book_time[i][0].split(":");
            String[] endTime = book_time[i][1].split(":");

            int start = Integer.parseInt(startTime[0]) * 60 + Integer.parseInt(startTime[1]);
            int end = Integer.parseInt(endTime[0]) * 60 + Integer.parseInt(endTime[1]);
        
            bookTime[i][0] = start;
            bookTime[i][1] = end;
        }
        
        // for (int i = 0; i < bookTime.length; i++) {
        //     System.out.println("start, end" + " " + bookTime[i][0] + " " + bookTime[i][1]);
        // }

        // bookTime을 대실 시작시각을 기준으로 오름차순 정렬(2차원 배열 정렬하는 방법)
        Arrays.sort(bookTime, (a, b) -> {
            return a[0] - b[0];
        });
        
        // for (int i = 0; i < bookTime.length; i++) {
        //     System.out.println("start, end" + " " + bookTime[i][0] + " " + bookTime[i][1]);
        // }

        PriorityQueue<Integer> pq = new PriorityQueue<>();

        for (int i = 0; i < bookTime.length; i++) {
            
            while (!pq.isEmpty() && pq.peek() <= bookTime[i][0]) {
                pq.poll();
            }
            pq.add(bookTime[i][1] + 10);

            answer = Math.max(answer, pq.size());
        }
        
        return answer;
    }
}